<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox fx:id="rootHBox"
      alignment="CENTER_LEFT" spacing="10.0"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controllers.categories.SubCategoryRowController"
      style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-border-width: 1; -fx-padding: 8 14 8 14;">

    <!-- Sub Category Title -->
    <Label fx:id="subCategoryTitle" text="category_title"
           style="-fx-font-size: 13px; -fx-text-fill: #333333;" />

    <Region HBox.hgrow="ALWAYS" />

    <!-- Edit Button -->
    <Button text="✏"
            onAction="#handleEdit"
            style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 8 4 8;" />

    <!-- Delete Button -->
    <Button text="🗑"
            onAction="#handleDelete"
            style="-fx-background-color: transparent; -fx-text-fill: #cc3333; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 8 4 8;" />

</HBox>
