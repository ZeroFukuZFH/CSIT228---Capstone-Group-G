<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: white; -fx-padding: 20;"
      fx:controller="com.example.csit228capstone.controllers.dashboard.NewTransactionController"
>

    <Label text="New Transaction" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Separator/>

    <Label text="Title:"/>
    <TextField fx:id="titleField" promptText="Enter title"/>

    <Label text="Description:"/>
    <TextField fx:id="descriptionField" promptText="Enter description"/>

    <Label text="Amount:"/>
    <TextField fx:id="amountField" promptText="Enter amount"/>

    <Separator/>

    <Label text="Account:"/>
    <ComboBox fx:id="accountBox" promptText="Select Account"/>

    <Label text="Category:"/>
    <ComboBox fx:id="categoryBox" promptText="Select Category"/>

    <Label text="Type:"/>
    <ComboBox fx:id="typeBox" promptText="Select Type"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save" onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

</VBox>