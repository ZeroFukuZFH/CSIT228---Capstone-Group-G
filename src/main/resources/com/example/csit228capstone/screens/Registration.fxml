<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.RegistrationController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="550.0" prefWidth="900.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">
                    <children>

                        <VBox alignment="CENTER" prefWidth="450.0" spacing="15.0" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
                            </padding>
                            <children>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label text="Create Account" textFill="#1a1a1a">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label text="Please fill in your details below" textFill="#888888" />
                                    </children>
                                </VBox>

                                <!-- Navigation Toggle -->
                                <HBox alignment="CENTER" maxWidth="220.0" prefHeight="40.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 10;">
                                    <children>
                                        <!-- Linked to onSignInClick -->
                                        <Button onAction="#onSignInClick" mnemonicParsing="false" prefWidth="110.0" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-cursor: hand;" text="Sign In" />
                                        <Button mnemonicParsing="false" prefWidth="110.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-text-fill: #1a1a1a;" text="Sign Up">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="fullNameField" prefHeight="45.0" promptText="Full Name" style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                                        <TextField fx:id="usernameField" prefHeight="45.0" promptText="Username" style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                                        <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Password" style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                                        <PasswordField fx:id="confirmPasswordField" prefHeight="45.0" promptText="Confirm Password" style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                                    </children>
                                </VBox>

                                <Button fx:id="continueButton" onAction="#handleRegistration" maxWidth="1.7976931348623157E308" prefHeight="45.0" style="-fx-background-color: #1a73e8; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Continue" />

                                <Label text="Or Register With:" textFill="#888888">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>

                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <Button style="-fx-background-color: transparent; -fx-border-color: #e0e0e0; -fx-border-radius: 20; -fx-padding: 5;">
                                            <graphic>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                                    <image><Image url="@../images/Registration.png" /></image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefWidth="450.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 0 20 20 0;" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="400.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/Registration.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>