<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.cashflow.CashflowController">
    <children>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />

        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <VBox prefHeight="320.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Cash Flow Timeline Comparison" textFill="#333333">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <VBox.margin><Insets left="10.0" bottom="5.0"/></VBox.margin>
                        </Label>
                        <BarChart fx:id="cashflowBarChart" animated="false" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" fx:id="xAxis" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>

                        <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Total Income Breakdown" textFill="#333333">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                    <VBox.margin><Insets left="5.0" bottom="10.0"/></VBox.margin>
                                </Label>
                                <PieChart fx:id="cashflowIncomePieChart" animated="false" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Total Expenses Breakdown" textFill="#333333">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                    <VBox.margin><Insets left="5.0" bottom="10.0"/></VBox.margin>
                                </Label>
                                <PieChart fx:id="cashflowExpensesPieChart" animated="false" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</HBox>