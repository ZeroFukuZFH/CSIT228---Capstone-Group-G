<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
    <children>

        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
        <!-- Main Content Area -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="⇆" />
                        <Button style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="🏷" />
                        <Button style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="🏦" />
                        <Button style="-fx-background-color: #3a6351; -fx-text-fill: white; -fx-background-radius: 8;" text="+ New Transaction">
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
                <VBox prefHeight="610.0" prefWidth="790.0" >
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />

                        <!-- ADD CONTENT HERE -->


                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
