<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controllers.expenses.ExpensesController">
    <children>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />

        <!-- Main Content Area -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

                <!-- Action Buttons Row (included) -->
                <fx:include source="ActionButtons.fxml" fx:id="actionbuttons"/>

                <!-- Main White Card Container -->
                <VBox prefHeight="610.0" prefWidth="790.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>

                        <!-- ═══ CHART SECTION ═══ -->
                        <VBox spacing="10.0"
                              style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1;">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>

                                <!-- Chart Header: date label + day/month/year toggles -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <!-- Date Label / Button -->
                                        <Button fx:id="selectedDateBtn"
                                                text="selected_date"
                                                style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 6 14 6 14; -fx-cursor: hand;" />

                                        <!-- Spacer -->
                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Day / Month / Year Toggle Group -->
                                        <HBox spacing="0.0">
                                            <children>
                                                <ToggleButton fx:id="dayToggle"
                                                              text="day"
                                                              selected="true"
                                                              style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 6 18 6 18; -fx-background-radius: 6 0 0 6; -fx-border-radius: 6 0 0 6; -fx-cursor: hand;">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="periodToggleGroup"/>
                                                    </toggleGroup>
                                                </ToggleButton>
                                                <ToggleButton fx:id="monthToggle"
                                                              text="month"
                                                              toggleGroup="$periodToggleGroup"
                                                              style="-fx-background-color: white; -fx-text-fill: #333; -fx-font-size: 13px; -fx-padding: 6 18 6 18; -fx-background-radius: 0; -fx-border-radius: 0; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 1; -fx-cursor: hand;" />
                                                <ToggleButton fx:id="yearToggle"
                                                              text="year"
                                                              toggleGroup="$periodToggleGroup"
                                                              style="-fx-background-color: white; -fx-text-fill: #333; -fx-font-size: 13px; -fx-padding: 6 18 6 18; -fx-background-radius: 0 6 6 0; -fx-border-radius: 0 6 6 0; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Bar Chart -->
                                <BarChart fx:id="expensesBarChart"
                                          prefHeight="200.0"
                                          prefWidth="700.0"
                                          barGap="4"
                                          categoryGap="20"
                                          animated="false"
                                          legendVisible="false"
                                          style="-fx-background-color: transparent;">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis"
                                                      style="-fx-tick-label-font-size: 11px;" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis"
                                                    lowerBound="0"
                                                    upperBound="200"
                                                    tickUnit="50"
                                                    autoRanging="false"
                                                    style="-fx-tick-label-font-size: 11px;" />
                                    </yAxis>
                                </BarChart>

                            </children>
                        </VBox>

                        <!-- Spacing between chart and list -->
                        <Region prefHeight="15.0" />

                        <!-- ═══ EXPENSES LIST SECTION ═══ -->
                        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- Expenses Header Row -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Expenses"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />

                                        <!-- Spacer -->
                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Sort Button -->
                                        <Button fx:id="sortBtn"
                                                text="Sort By : sort_type"
                                                style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-padding: 6 12 6 12; -fx-cursor: hand;" />

                                        <!-- Search Field -->
                                        <TextField fx:id="searchField"
                                                   promptText="Search by Title"
                                                   prefWidth="220.0"
                                                   style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-padding: 6 10 6 10;" />

                                        <!-- Add Button -->
                                        <Button fx:id="addBtn"
                                                text="+"
                                                style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-padding: 0; -fx-cursor: hand;"
                                                onAction="#handleAddExpense" />
                                    </children>
                                </HBox>

                                <!-- Transaction List (Scrollable) -->
                                <ScrollPane fx:id="transactionScrollPane"
                                            fitToWidth="true"
                                            VBox.vgrow="ALWAYS"
                                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: transparent;">
                                    <content>
                                        <VBox fx:id="transactionListVBox" spacing="8.0"
                                              style="-fx-background-color: transparent;">
                                            <padding>
                                                <Insets bottom="5.0" right="5.0" />
                                            </padding>
                                            <children>

                                                <!-- Sample Transaction Row (will be generated dynamically) -->
                                                <HBox alignment="CENTER_LEFT" spacing="15.0"
                                                      style="-fx-background-color: #f9f9f9; -fx-border-color: #eeeeee; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 10 15 10 15;">
                                                    <children>
                                                        <!-- Icon -->
                                                        <Label text="🏠"
                                                               style="-fx-font-size: 20px; -fx-background-color: #eeeeee; -fx-background-radius: 50; -fx-padding: 6;" />

                                                        <!-- Name -->
                                                        <Label fx:id="transactionNameLabel"
                                                               text="transaction_name"
                                                               style="-fx-font-size: 13px; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;" />

                                                        <!-- Date -->
                                                        <Label fx:id="transactionDateLabel"
                                                               text="transaction_date"
                                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;" />

                                                        <Region HBox.hgrow="ALWAYS" />

                                                        <!-- Type Badge -->
                                                        <Label fx:id="transactionTypeLabel"
                                                               text="expense"
                                                               style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 12 4 12; -fx-background-radius: 4;" />

                                                        <!-- Amount -->
                                                        <Label fx:id="transactionAmountLabel"
                                                               text="-transaction_amount"
                                                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <!-- ═══ PAGINATION ═══ -->
                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <!-- Prev Button -->
                                        <Button fx:id="prevPageBtn"
                                                text="←"
                                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;"
                                                onAction="#handlePrevPage" />

                                        <!-- Page Label -->
                                        <Label fx:id="pageLabel"
                                               text="current_page/total_pages"
                                               style="-fx-font-size: 11px; -fx-text-fill: #555555; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 10 5 10;" />

                                        <!-- Next Button -->
                                        <Button fx:id="nextPageBtn"
                                                text="→"
                                                style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;"
                                                onAction="#handleNextPage" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</HBox>
