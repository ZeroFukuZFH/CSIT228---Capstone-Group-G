<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.options.OptionsController">
    <children>

        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
        <!-- Main Content Area -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <VBox prefHeight="610.0" prefWidth="790.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <!-- CONTENT -->

                    <children>
                        <!-- Import to csv -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="679.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Import to csv" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Import transaction data to csv" />
                                </children>
                            </VBox>
                            <Button onAction="#handleImport" style="-fx-background-color: #3a6351; -fx-text-fill: white; -fx-background-radius: 5;" text="Import" />
                        </HBox>

                        <!-- Export to File -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="678.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Export to File" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Export transaction data to csv" />
                                </children>
                            </VBox>
                            <Button onAction="#handleExport" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-text-fill: #333;" text="Export" />
                        </HBox>

                        <!-- Default Currency -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="583.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Default Currency" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="default_currency" />
                                </children>
                            </VBox>
                            <ComboBox fx:id="defaultCurrencyComboBox" onAction="#handleDefaultCurrency" promptText="Select currency" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-pref-width: 150;" />
                        </HBox>

                    </children>

                    <!-- END OF CONTENT -->
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
