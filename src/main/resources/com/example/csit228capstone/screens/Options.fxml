<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.options.OptionsController">
    <children>

        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
        <!-- Main Content Area -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <VBox prefHeight="610.0" prefWidth="790.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <!-- CONTENT -->

                    <children>
                        <!-- Header -->
                        <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #333;" text="Settings" />

                        <Separator style="-fx-background-color: #e0e0e0;" />

                        <!-- Import to csv -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="679.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #333;" text="Import from CSV" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Import transaction data from CSV file" />
                                </children>
                            </VBox>
                            <Button onAction="#handleImport" style="-fx-background-color: #3a6351; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Import" />
                        </HBox>

                        <!-- Export to File -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="678.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #333;" text="Export to CSV" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Export transaction data to CSV file" />
                                </children>
                            </VBox>
                            <Button onAction="#handleExport" style="-fx-background-color: white; -fx-border-color: #3a6351; -fx-border-radius: 5; -fx-text-fill: #3a6351; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Export" />
                        </HBox>

                        <!-- Separator -->
                        <Separator style="-fx-background-color: #e0e0e0;" />

                        <!-- Default Currency -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox prefHeight="38.0" prefWidth="583.0" spacing="5.0">
                                <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #333;" text="Default Currency" />
                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Select your preferred currency for all transactions" />
                                </children>
                            </VBox>
                            <ComboBox fx:id="defaultCurrencyComboBox" onAction="#handleDefaultCurrency" promptText="Select currency" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-pref-width: 150; -fx-background-radius: 5;" />
                        </HBox>

                    </children>

                    <!-- END OF CONTENT -->
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>