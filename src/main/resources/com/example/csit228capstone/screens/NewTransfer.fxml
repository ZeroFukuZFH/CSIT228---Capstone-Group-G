<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: white; -fx-padding: 20;"
        fx:controller="com.example.csit228capstone.controllers.NewTransferController"
>
    <HBox>
        <Label text="New Transaction" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <Separator/>

    <Label text="From:"/>
    <TextField fx:id="fromField" promptText="Enter title"/>

    <Label text="To:"/>
    <TextField fx:id="toField" promptText="type any text"/>

    <Label text="Amount:"/>
    <TextField fx:id="amountField" promptText="type any text"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save" onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

</VBox>