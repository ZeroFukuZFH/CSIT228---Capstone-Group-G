<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootVBox"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controllers.categories.CategoryRowController"
      spacing="4.0">

    <!-- Parent Category Row -->
    <HBox alignment="CENTER_LEFT" spacing="10.0"
          style="-fx-background-color: #f9f9f9; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14 10 14;">

        <!-- Icon Box -->
        <StackPane prefWidth="36.0" prefHeight="36.0"
                   style="-fx-background-color: #eeeeee; -fx-background-radius: 8;">
            <Label fx:id="categoryIcon" text="🏠"
                   style="-fx-font-size: 16px;" />
        </StackPane>

        <!-- Category Title -->
        <Label fx:id="categoryTitle" text="category_title"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Add Sub Category Button -->
        <Button text="Add Sub Category"
                onAction="#handleAddSubCategory"
                style="-fx-background-color: #1e5631; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 5 10 5 10; -fx-cursor: hand;" />

        <!-- Edit Button -->
        <Button text="✏"
                onAction="#handleEdit"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8 4 8;" />

        <!-- Delete Button -->
        <Button text="🗑"
                onAction="#handleDelete"
                style="-fx-background-color: transparent; -fx-text-fill: #cc3333; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8 4 8;" />

    </HBox>

    <!-- Sub Category Container -->
    <VBox fx:id="subCategoryContainer" spacing="4.0">
        <padding>
            <Insets left="20.0" />
        </padding>
    </VBox>

</VBox>
