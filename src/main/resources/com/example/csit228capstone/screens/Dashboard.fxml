<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.dashboard.DashboardController">
    <children>

        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
        <!-- Main Content Area -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

                <VBox prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <!-- ADD CONTENT HERE -->
                        <VBox prefHeight="286.0" prefWidth="770.0">
                            <children>
                                <Label fx:id="currentDate" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                                <HBox alignment="CENTER" prefHeight="236.0" prefWidth="770.0" spacing="20.0">
                                    <children>
                                        <VBox alignment="CENTER" prefHeight="150.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-text-fill: #dc3545; -fx-font-weight: bold; -fx-font-size: 16px;" text="EXPENSES">
                                                    <font>
                                                        <Font size="16.0" />
                                                    </font>
                                                </Label>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <children>
                                                        <Label fx:id="expenseCurrency" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                                                        <Label fx:id="totalExpenses" style="-fx-text-fill: #dc3545; -fx-font-weight: bold; -fx-font-size: 24px;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                            </padding>
                                        </VBox>
                                        <VBox alignment="CENTER" prefHeight="150.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-text-fill: #28a745; -fx-font-weight: bold; -fx-font-size: 16px;" text="INCOME">
                                                    <font>
                                                        <Font size="16.0" />
                                                    </font>
                                                </Label>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <children>
                                                        <Label fx:id="incomeCurrency" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                                                        <Label fx:id="totalIncome" style="-fx-text-fill: #28a745; -fx-font-weight: bold; -fx-font-size: 24px;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                            </padding>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox prefHeight="286.0" prefWidth="770.0" spacing="15.0">
                            <children>
                                <HBox alignment="CENTER" prefHeight="51.0" prefWidth="770.0" spacing="20.0">
                                    <children>
                                        <Label style="-fx-text-fill: #333; -fx-font-weight: bold; -fx-font-size: 18px;" text="TRANSACTIONS" />
                                        <ComboBox fx:id="accountComboBox" prefHeight="27.0" prefWidth="123.0" promptText="Select Account" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd;" />
                                        <ComboBox fx:id="categoriesComboBox" prefHeight="27.0" prefWidth="125.0" promptText="Select Category" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd;" />
                                        <TextField fx:id="searchTextField" prefHeight="27.0" prefWidth="160.0" promptText="Search Transactions" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd;" />
                                        <Button onAction="#onAddTransactionClick" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="add new transaction" />
                                    </children>
                                </HBox>
                                <!-- Additional content here -->
                                <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="251.0" prefWidth="770.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                    <content>
                                        <VBox fx:id="contentBox" spacing="5.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
