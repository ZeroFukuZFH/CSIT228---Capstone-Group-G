<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_RIGHT" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controllers.ActionButtonsController">
    <children>
        <Button onAction="#handleTransfer" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="⇆" />
        <Button onAction="#handleCategory" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="🏷" />
        <Button onAction="#handleAccount" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-cursor: hand;" text="🏦" />
        <Button onAction="#handleNewTransaction" style="-fx-background-color: #3a6351; -fx-text-fill: white; -fx-background-radius: 8;" text="+ New Transaction">
            <padding>
                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
            </padding>
        </Button>
    </children>
</HBox>