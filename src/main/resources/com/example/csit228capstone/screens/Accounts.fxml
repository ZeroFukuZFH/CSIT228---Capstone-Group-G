<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1100.0"
      styleClass="main-bg"
      stylesheets="@../styles/styles.css"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controllers.accounts.AccountsController">
    <children>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>

        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
            </padding>
            <children>

                <VBox prefHeight="610.0" prefWidth="790.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <padding>
                            <Insets bottom="24.0" left="4.0" right="4.0" top="8.0"/>
                        </padding>
                        <Label text="Accounts" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="addAccountBtn" text="add account  +" styleClass="add-account-btn" onAction="#handleAddAccount">
                            <padding>
                                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0"/>
                            </padding>
                        </Button>
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                                VBox.vgrow="ALWAYS">
                        <VBox spacing="14.0" fx:id="accountListContainer">
                            <padding>
                                <Insets bottom="10.0" left="4.0" right="4.0" top="4.0"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>